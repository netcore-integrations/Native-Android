<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/nc_surface">

        <!-- ═══ IMAGE AREA with overlays ═══ -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="155dp">

            <!-- Product image -->
            <ImageView
                android:id="@+id/iv_product"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Product image" />

            <!-- Bottom gradient scrim for category label legibility -->
            <View
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_image_scrim" />

            <!-- Discount badge — top-left -->
            <TextView
                android:id="@+id/tv_discount_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="7dp"
                android:layout_gravity="top|start"
                android:background="@drawable/bg_discount_badge"
                android:paddingStart="7dp"
                android:paddingTop="3dp"
                android:paddingEnd="7dp"
                android:paddingBottom="3dp"
                android:text="-10%"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Wishlist heart — top-right -->
            <ImageView
                android:id="@+id/iv_wishlist"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:layout_margin="7dp"
                android:background="@drawable/bg_wishlist_btn"
                android:padding="6dp"
                android:src="@drawable/ic_heart_24"
                android:contentDescription="Add to wishlist"
                app:tint="@color/secondaryTextColor" />

            <!-- Category label — bottom-left on scrim -->
            <TextView
                android:id="@+id/tv_category_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="6dp"
                android:text="Category"
                android:textColor="#CCFFFFFF"
                android:textSize="9sp"
                android:textAllCaps="true"
                android:letterSpacing="0.08" />

        </FrameLayout>

        <!-- ═══ PRODUCT INFO SECTION ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="9dp"
            android:paddingBottom="10dp">

            <!-- Product title — 2 lines max -->
            <TextView
                android:id="@+id/tv_product_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Product Name"
                android:textColor="@color/primaryTextColor"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.15" />

            <!-- Rating + Stock row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="5dp">

                <TextView
                    android:id="@+id/tv_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★ 4.5"
                    android:textColor="@color/star_color"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@color/secondaryTextColor"
                    android:alpha="0.4" />

                <TextView
                    android:id="@+id/tv_stock"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="In stock"
                    android:textColor="@color/nc_success"
                    android:textSize="10sp" />

            </LinearLayout>

            <!-- Price row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="5dp">

                <TextView
                    android:id="@+id/tv_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$99.99"
                    android:textColor="@color/price_color"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_original_price"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:text="$120.00"
                    android:textColor="@color/original_price_color"
                    android:textSize="11sp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Add to Cart button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_cart"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="9dp"
                android:text="Add to Cart"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@color/nc_primary"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_add_shopping_cart_24"
                app:iconSize="16dp"
                app:iconPadding="6dp"
                app:iconTint="@color/white" />

        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
